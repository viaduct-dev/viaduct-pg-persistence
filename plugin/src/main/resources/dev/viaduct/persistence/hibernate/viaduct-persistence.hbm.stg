delimiters "$", "$"

main(mdl) ::= <<
<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping xmlns="http://www.hibernate.org/xsd/orm/hbm" schema="public">
$mdl.entities:{entity |$renderEntity(entity)$}$
</hibernate-mapping>
>>

renderEntity(entity) ::= <<
  <class entity-name="$entity.entityName; format="xml-encode"$" table="$entity.tableName; format="xml-encode"$"$if(entity.schemaName)$ schema="$entity.schemaName; format="xml-encode"$"$endif$ lazy="false">
$entity.attributes:{attribute |$renderAttribute(attribute)$}$
  </class>
>>

renderAttribute(attribute) ::= <<
$if(attribute.basic)$$renderBasic(attribute.basic)$$endif$$if(attribute.toOne)$$renderToOne(attribute.toOne)$$endif$$if(attribute.toMany)$$renderToMany(attribute.toMany)$$endif$
>>

renderBasic(basic) ::= <<
    <$basic.elementName$ name="$basic.name; format="xml-encode"$" type="$basic.hibernateType; format="xml-encode"$"$if(!basic.primaryKey)$ not-null="$basic.notNull$"$endif$$if(basic.noInsert)$ insert="false"$endif$$if(basic.noUpdate)$ update="false"$endif$>
      <column name="$basic.columnName; format="xml-encode"$" not-null="$basic.notNull$"$if(basic.columnDefinition)$ sql-type="$basic.columnDefinition; format="xml-encode"$"$endif$ />
$if(basic.primaryKey)$
      <generator class="assigned" />
$endif$
    </$basic.elementName$>
>>

renderToOne(toOne) ::= <<
    <many-to-one name="$toOne.name; format="xml-encode"$" entity-name="$toOne.targetEntityName; format="xml-encode"$" not-null="$toOne.notNull$" lazy="proxy" foreign-key="$toOne.foreignKeyName; format="xml-encode"$">
      <column name="$toOne.columnName; format="xml-encode"$" not-null="$toOne.notNull$" sql-type="uuid" />
    </many-to-one>
>>

renderToMany(toMany) ::= <<
    <bag name="$toMany.name; format="xml-encode"$" lazy="true"$if(toMany.inverse)$ inverse="true"$endif$$if(toMany.joinTableName)$ table="$toMany.joinTableName; format="xml-encode"$"$endif$$if(toMany.joinSchemaName)$ schema="$toMany.joinSchemaName; format="xml-encode"$"$endif$>
      <key column="$toMany.keyColumnName; format="xml-encode"$" not-null="true" />
$if(toMany.oneToMany)$
      <one-to-many entity-name="$toMany.targetEntityName; format="xml-encode"$" />
$else$
      <many-to-many entity-name="$toMany.targetEntityName; format="xml-encode"$" foreign-key="$toMany.targetForeignKeyName; format="xml-encode"$" column="$toMany.targetColumnName; format="xml-encode"$" />
$endif$
    </bag>
>>
